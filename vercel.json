{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "python",
      "bindings": [
        {
          "type": "service",
          "service": "visualization",
          "format": "url",
          "env": "VISUALIZATION_SERVICE_URL"
        }
      ]
    },
    "visualization": {
      "root": "visualization",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
